{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#sql/*": "./src/sql/*.js",
    "#util/*": "./src/util/*.js",
    "#services/*": "./src/services/internal/*.js",
    "#middleware/*": "./src/middleware/*.js",
    "#sync/*": "./src/sync/*.js"
  },
  "scripts": {
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" src/cluster.js",
    "prod": "node src/cluster.js",
    "migrate": "node src/migrate.js --action=up",
    "migrate:create": "node-pg-migrate create test",
    "migrate:up": "node --env-file-if-exists=.env src/migrate.js --action=up",
    "migrate:down": "node --env-file-if-exists=.env src/migrate.js --action=down",
    "test": "node --test \"test/**/*.test.js\""
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.17",
    "nodemon": "^3.1.14"
  }
}
